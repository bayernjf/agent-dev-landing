---
import BayjfLink from '@bay/landing-ui/components/BayjfLink.astro';
import { useTranslations, localizePath, type Lang } from '../i18n';
import { SITE_NAME, SOCIAL } from '../consts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const links = [
  { href: localizePath('/about', lang), label: t('nav.about') },
  { href: localizePath('/blog', lang), label: t('nav.blog') },
  { href: localizePath('/pricing', lang), label: t('nav.pricing') },
  { href: SOCIAL.docs, label: t('nav.docs'), external: true },
  { href: SOCIAL.github, label: 'GitHub', external: true },
  { href: 'https://bayjf.com', label: 'BayJF', external: true },
  { href: localizePath('/privacy', lang), label: lang === 'zh' ? '隐私政策' : 'Privacy' },
  { href: localizePath('/terms', lang), label: lang === 'zh' ? '服务条款' : 'Terms' },
];
---

<footer class="border-t border-ink-800/60 bg-ink-950">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="flex flex-col items-center justify-between gap-6 sm:flex-row">
      <div class="flex items-center gap-2">
        <svg viewBox="0 0 32 32" class="h-6 w-6" aria-hidden="true">
          <defs>
            <linearGradient id="adFtBg" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#1e2a5a" />
              <stop offset="100%" stop-color="#0b1120" />
            </linearGradient>
            <linearGradient id="adFtInk" x1="9" y1="3" x2="23" y2="29" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#22d3ee" />
              <stop offset="55%" stop-color="#818cf8" />
              <stop offset="100%" stop-color="#c084fc" />
            </linearGradient>
            <mask id="adFtHole">
              <rect width="32" height="32" fill="white" />
              <circle cx="16" cy="16" r="7.2" fill="black" />
            </mask>
          </defs>
          <rect width="32" height="32" rx="7" fill="url(#adFtBg)" />
          <g fill="url(#adFtInk)" mask="url(#adFtHole)">
            <circle cx="16" cy="16" r="9.4" />
            <rect x="14.3" y="3.4" width="3.4" height="4.4" rx="1.2" />
            <rect x="14.3" y="3.4" width="3.4" height="4.4" rx="1.2" transform="rotate(45 16 16)" />
            <rect x="14.3" y="3.4" width="3.4" height="4.4" rx="1.2" transform="rotate(90 16 16)" />
            <rect x="14.3" y="3.4" width="3.4" height="4.4" rx="1.2" transform="rotate(135 16 16)" />
            <rect x="14.3" y="3.4" width="3.4" height="4.4" rx="1.2" transform="rotate(180 16 16)" />
            <rect x="14.3" y="3.4" width="3.4" height="4.4" rx="1.2" transform="rotate(225 16 16)" />
            <rect x="14.3" y="3.4" width="3.4" height="4.4" rx="1.2" transform="rotate(270 16 16)" />
            <rect x="14.3" y="3.4" width="3.4" height="4.4" rx="1.2" transform="rotate(315 16 16)" />
          </g>
          <path d="M12.6 12.6 L9.6 16 L12.6 19.4" fill="none" stroke="url(#adFtInk)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M19.4 12.6 L22.4 16 L19.4 19.4" fill="none" stroke="url(#adFtInk)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <div>
          <p class="text-sm font-medium text-ink-100">{SITE_NAME}</p>
          <p class="text-xs text-ink-500">{t('footer.tagline')}</p>
        </div>
      </div>

      <nav class="flex flex-wrap items-center justify-center gap-5">
        {links.map((l) => (
          l.href === 'https://bayjf.com' ? (
            <BayjfLink
              size={16}
              class="text-xs text-ink-400 transition hover:text-ink-100"
              label={l.label}
            />
          ) : (
            <a
              href={l.href}
              class="text-xs text-ink-400 transition hover:text-ink-100"
            >
              {l.label}
            </a>
          )
        ))}
      </nav>
    </div>

    <div class="mt-8 border-t border-ink-800/50 pt-6 text-center">
      <p class="text-xs text-ink-500">
        © {year} {SITE_NAME}. {t('footer.rights')}
      </p>
    </div>
  </div>
</footer>
