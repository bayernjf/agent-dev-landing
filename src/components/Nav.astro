---
import BayjfLink from '@bay/landing-ui/components/BayjfLink.astro';
import { useTranslations, localizePath, getAltLangPath, type Lang } from '../i18n';
import { SITE_NAME, SOCIAL } from '../consts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const navItems = [
  { href: localizePath('/#features', lang), label: t('nav.features') },
  { href: localizePath('/#comparison', lang), label: t('nav.comparison') },
  { href: localizePath('/#principles', lang), label: t('nav.principles') },
  { href: localizePath('/#faq', lang), label: t('nav.faq') },
  { href: localizePath('/blog', lang), label: t('nav.blog') },
  { href: SOCIAL.docs, label: t('nav.docs'), external: true },
];

const altLang = lang === 'zh' ? 'en' : 'zh';
const altLangHref = getAltLangPath(Astro.url.pathname, altLang);
---

<header class="sticky top-0 z-50 border-b border-ink-800/60 bg-ink-950/80 backdrop-blur-md">
  <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href={localizePath('/', lang)} class="flex items-center gap-2 text-base font-semibold text-ink-50">
      <svg viewBox="0 0 32 32" class="h-7 w-7" aria-hidden="true">
        <defs>
          <linearGradient id="adNavBg" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#1e2a5a" />
            <stop offset="100%" stop-color="#0b1120" />
          </linearGradient>
          <linearGradient id="adNavInk" x1="9" y1="3" x2="23" y2="29" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#22d3ee" />
            <stop offset="55%" stop-color="#818cf8" />
            <stop offset="100%" stop-color="#c084fc" />
          </linearGradient>
          <mask id="adNavHole">
            <rect width="32" height="32" fill="white" />
            <circle cx="16" cy="16" r="7.2" fill="black" />
          </mask>
        </defs>
        <rect width="32" height="32" rx="7" fill="url(#adNavBg)" />
        <g fill="url(#adNavInk)" mask="url(#adNavHole)">
          <circle cx="16" cy="16" r="9.4" />
          <rect x="14.3" y="3.4" width="3.4" height="4.4" rx="1.2" />
          <rect x="14.3" y="3.4" width="3.4" height="4.4" rx="1.2" transform="rotate(45 16 16)" />
          <rect x="14.3" y="3.4" width="3.4" height="4.4" rx="1.2" transform="rotate(90 16 16)" />
          <rect x="14.3" y="3.4" width="3.4" height="4.4" rx="1.2" transform="rotate(135 16 16)" />
          <rect x="14.3" y="3.4" width="3.4" height="4.4" rx="1.2" transform="rotate(180 16 16)" />
          <rect x="14.3" y="3.4" width="3.4" height="4.4" rx="1.2" transform="rotate(225 16 16)" />
          <rect x="14.3" y="3.4" width="3.4" height="4.4" rx="1.2" transform="rotate(270 16 16)" />
          <rect x="14.3" y="3.4" width="3.4" height="4.4" rx="1.2" transform="rotate(315 16 16)" />
        </g>
        <path d="M12.6 12.6 L9.6 16 L12.6 19.4" fill="none" stroke="url(#adNavInk)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M19.4 12.6 L22.4 16 L19.4 19.4" fill="none" stroke="url(#adNavInk)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span>{SITE_NAME}</span>
    </a>

    <div class="hidden items-center gap-6 md:flex">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="text-sm text-ink-300 transition hover:text-ink-50"
        >
          {item.label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-3">
      <a
        href={altLangHref}
        class="rounded-md px-2 py-1 text-xs text-ink-400 transition hover:text-ink-100"
      >
        {t('nav.langSwitch')}
      </a>
      <BayjfLink size={18} class="hidden rounded-md px-2 py-1.5 text-xs text-ink-300 transition hover:text-ink-50 sm:inline-block" />
      <a
        href={SOCIAL.github}
        target="_blank"
        rel="noopener"
        class="hidden rounded-md border border-ink-700 px-3 py-1.5 text-xs text-ink-200 transition hover:border-ink-500 hover:text-white sm:inline-block"
      >
        GitHub
      </a>
    </div>
  </nav>
</header>
