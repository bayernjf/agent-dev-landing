---
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const isZh = lang === 'zh';

// 对比维度：聚焦 Agent-Dev 的差异化，而非代码生成速度
const rows =
  isZh
    ? [
        { dim: '管理单位', ad: '产品生命周期', replit: '单次会话', lovable: '单次生成', spec: '规格与任务' },
        { dim: '用户拥有资源', ad: '是，自有 GitHub/云', replit: '否，Replit 托管', lovable: '部分', spec: '是' },
        { dim: 'Agent 可替换', ad: '是', replit: '否', lovable: '否', spec: '部分' },
        { dim: 'Provider 可迁移', ad: '是，受控迁移', replit: '否', lovable: '否', spec: '不涉及' },
        { dim: '生产权限', ad: 'Policy + 人工 Gate', replit: '平台托管', lovable: '平台托管', spec: '人工 Gate' },
        { dim: '交付证据', ad: '外部事实链', replit: '平台日志', lovable: 'Preview', spec: '任务状态' },
        { dim: '长期维护', ad: '漂移检测 + 修复策略', replit: '有限', lovable: '有限', spec: '不涉及' },
      ]
    : [
        { dim: 'Unit managed', ad: 'Product lifecycle', replit: 'Single session', lovable: 'Single generation', spec: 'Specs and tasks' },
        { dim: 'User-owned resources', ad: 'Yes, own GitHub/cloud', replit: 'No, Replit-hosted', lovable: 'Partial', spec: 'Yes' },
        { dim: 'Replaceable Agent', ad: 'Yes', replit: 'No', lovable: 'No', spec: 'Partial' },
        { dim: 'Portable providers', ad: 'Yes, controlled migration', replit: 'No', lovable: 'No', spec: 'N/A' },
        { dim: 'Production permission', ad: 'Policy + manual gate', replit: 'Platform-managed', lovable: 'Platform-managed', spec: 'Manual gate' },
        { dim: 'Delivery evidence', ad: 'External fact chain', replit: 'Platform logs', lovable: 'Preview', spec: 'Task status' },
        { dim: 'Long-term maintenance', ad: 'Drift detection + fix policy', replit: 'Limited', lovable: 'Limited', spec: 'N/A' },
      ];

const cols = isZh
  ? [
      { key: 'dim', label: '维度' },
      { key: 'ad', label: 'Agent-Dev' },
      { key: 'replit', label: 'Replit Agent' },
      { key: 'lovable', label: 'Lovable' },
      { key: 'spec', label: 'GitHub Spec Kit' },
    ]
  : [
      { key: 'dim', label: 'Dimension' },
      { key: 'ad', label: 'Agent-Dev' },
      { key: 'replit', label: 'Replit Agent' },
      { key: 'lovable', label: 'Lovable' },
      { key: 'spec', label: 'GitHub Spec Kit' },
    ];

const caption = isZh
  ? 'Agent-Dev 与 Replit Agent、Lovable、GitHub Spec Kit 的能力对比'
  : 'Agent-Dev vs Replit Agent, Lovable, GitHub Spec Kit';
---

<section id="comparison" aria-label={t('compare.title')} class="border-t border-ink-800/60 bg-ink-950 py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold text-ink-50 sm:text-4xl">{t('compare.title')}</h2>
      <p class="mt-3 text-ink-400">{t('compare.subtitle')}</p>
    </div>

    <div class="mt-12 overflow-x-auto">
      <table class="w-full border-collapse text-sm">
        <caption class="sr-only">{caption}</caption>
        <thead>
          <tr class="border-b border-ink-800">
            {cols.map((c, i) => (
              <th scope="col" class={`px-4 py-3 text-left font-medium ${i === 1 ? 'text-brand-300' : 'text-ink-400'}`}>
                {c.label}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr class="border-b border-ink-800/50">
              {cols.map((c, i) => (
                <td class={`px-4 py-3 ${i === 0 ? 'text-ink-300' : ''} ${i === 1 ? 'font-medium text-brand-200' : 'text-ink-400'}`}>
                  {(row as any)[c.key]}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
