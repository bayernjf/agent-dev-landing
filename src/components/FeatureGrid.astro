---
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const features =
  lang === 'zh'
    ? [
        {
          title: '用户拥有',
          desc: '代码、仓库、数据、域名、云资源和 Blueprint 归用户所有。退出 Agent-Dev 后，产品仍可独立构建、部署和维护。',
        },
        {
          title: '中立可迁移',
          desc: '模型和供应商均可替换。不绑定特定 Agent Runtime 或云平台，更换数据库或部署供应商是受控迁移而非设置修改。',
        },
        {
          title: '真实 Gate',
          desc: '大模型可以提出方案，但不能通过 Prompt 获得生产权限。确定性 Policy、GitHub Rulesets、Environment Approval 是最终约束。',
        },
        {
          title: '证据链交付',
          desc: '交付状态以 GitHub Checks、Deployment Records、Preview URL、数据库状态、冒烟测试和人工验收为准，而非 Agent 的自然语言总结。',
        },
      ]
    : [
        {
          title: 'User-owned',
          desc: 'Code, repos, data, domains, cloud resources, and Blueprint belong to the user. After leaving Agent-Dev, the product still builds, deploys, and maintains independently.',
        },
        {
          title: 'Neutral and portable',
          desc: 'Models and providers are replaceable. No lock-in to a specific Agent Runtime or cloud platform. Switching databases or deploy providers is a controlled migration, not a setting change.',
        },
        {
          title: 'Real gates',
          desc: 'An LLM may propose, but cannot obtain production permission via prompt. Deterministic Policy, GitHub Rulesets, and Environment Approval are the final constraints.',
        },
        {
          title: 'Evidence-based delivery',
          desc: 'Delivery status is grounded in GitHub Checks, Deployment Records, Preview URLs, database state, smoke tests, and manual acceptance — not the Agent\'s natural-language summary.',
        },
      ];
---

<section id="features" class="border-t border-ink-800/60 bg-ink-900/30 py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold text-ink-50 sm:text-4xl">{t('diff.title')}</h2>
      <p class="mt-3 text-ink-400">{t('diff.subtitle')}</p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2">
      {features.map((f) => (
        <blockquote class="rounded-xl border border-ink-800 bg-ink-900/60 p-6">
          <h3 class="text-lg font-semibold text-ink-50">{f.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink-300">{f.desc}</p>
        </blockquote>
      ))}
    </div>
  </div>
</section>
