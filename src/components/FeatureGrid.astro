---
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const features =
  lang === 'zh'
    ? [
        {
          title: '用户拥有',
          desc: '代码、仓库、数据、域名、云资源和 Blueprint 归用户所有。三个真实项目已验证：退出 Agent-Dev 后产品仍可独立构建、部署和维护。',
        },
        {
          title: '六类产品模板',
          desc: 'Web SaaS、落地页、浏览器插件（MV3）、桌面端（Tauri/Electron）、移动端（Expo）和 MCP Server，每类生成物都通过本地与真实 GitHub Actions 质量门禁。',
        },
        {
          title: '真实 Gate',
          desc: '大模型可以提出方案，但不能通过 Prompt 获得生产权限。生产发布为两道人工闸门（请求 + 具名批准），从生产分支 checkout 后发布。',
        },
        {
          title: '证据链交付',
          desc: '交付状态以 GitHub Checks、Deployment Records、Preview URL、冒烟测试和真实观测值为准，而非 Agent 的自然语言总结。未执行的验证不得标记通过。',
        },
      ]
    : [
        {
          title: 'User-owned',
          desc: 'Code, repos, data, domains, cloud resources, and Blueprint belong to the user. Three real projects have verified that products remain independently buildable, deployable, and maintainable after leaving Agent-Dev.',
        },
        {
          title: 'Six product templates',
          desc: 'Web SaaS, landing pages, browser extensions (MV3), desktop (Tauri/Electron), mobile (Expo), and MCP Server. Each artifact passes both local and real GitHub Actions quality gates.',
        },
        {
          title: 'Real gates',
          desc: 'An LLM may propose, but cannot obtain production permission via prompt. Production release requires two human gates (request + named approval), published from a production branch checkout.',
        },
        {
          title: 'Evidence-based delivery',
          desc: 'Delivery status is grounded in GitHub Checks, Deployment Records, Preview URLs, smoke tests, and real observations, not the Agent\'s natural-language summary. Unexecuted verifications cannot be marked as passed.',
        },
      ];
---

<section id="features" class="border-t border-ink-800/60 bg-ink-900/30 py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold text-ink-50 sm:text-4xl">{t('diff.title')}</h2>
      <p class="mt-3 text-ink-400">{t('diff.subtitle')}</p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2">
      {features.map((f) => (
        <blockquote class="rounded-xl border border-ink-800 bg-ink-900/60 p-6">
          <h3 class="text-lg font-semibold text-ink-50">{f.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink-300">{f.desc}</p>
        </blockquote>
      ))}
    </div>
  </div>
</section>
